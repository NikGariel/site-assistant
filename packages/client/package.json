{
  "name": "site-assistant-client",
  "version": "0.2.0",
  "description": "Browser SDK for AI-driven UI control — highlight, scroll, click, ghost cursor, tooltips via WebSocket",
  "license": "MIT",
  "keywords": ["websocket", "ai", "assistant", "ui-control", "browser", "sdk", "highlight", "ghost-cursor", "automation"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./umd": "./dist/index.umd.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "jsdom": "^25.0.1",
    "site-assistant-shared": "workspace:*",
    "ws": "^8.17.0"
  }
}
