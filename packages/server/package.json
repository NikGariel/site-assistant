{
  "name": "site-assistant-server",
  "version": "0.1.1",
  "description": "WebSocket server for remote UI control — send commands to browser windows via AI tools or MCP",
  "license": "MIT",
  "keywords": ["websocket", "ai", "assistant", "ui-control", "mcp", "tools", "remote-control", "highlight", "automation"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "site-assistant-shared": "workspace:*",
    "ws": "^8.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0"
  }
}
